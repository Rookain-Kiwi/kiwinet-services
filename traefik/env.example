# Traefik — adresse LAN de l'hôte sur laquelle publier les ports 80 et 443
# Copier ce fichier en .env et renseigner l'adresse (réservée dans le DHCP de la box)
# Ne jamais versionner le .env
# 192.0.2.10 est une adresse de documentation : à remplacer, sinon le démarrage échoue
# (adresse absente de l'hôte).

HOST_BIND_IP=192.0.2.10
