# ─────────────────────────────────────────────────────────────────────────────
# kiwinet-services/.gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Variables d'environnement — ne jamais versionner
.env
*.env

# Certificats Let's Encrypt — régénérés automatiquement par Traefik
traefik/acme*.json

# Identifiants basic auth — générer avec : htpasswd -nB <utilisateur> >> traefik/.htpasswd
traefik/.htpasswd


# ── Home Assistant ────────────────────────────────────────────────────────────
# Données HA persistantes — volumineuses et contiennent des secrets
home-assistant/config/
# Données et logs Mosquitto
home-assistant/mosquitto/data/
home-assistant/mosquitto/log/
# Config Mosquitto : seul mosquitto.conf est versionné (mots de passe, ACL exclus)
home-assistant/mosquitto/config/*
!home-assistant/mosquitto/config/mosquitto.conf

# ── PostgreSQL ────────────────────────────────────────────────────────────────
postgres/.env
pgadmin/.env

# ── Pi-hole ───────────────────────────────────────────────────────────────────
# Jeton du moniteur push d'Uptime Kuma : secret, ne jamais versionner
pi-hole/monitoring/push-url.conf

# ── Système ───────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo

# ── WebDAV Backups ────────────────────────────────────────────────────────────
webdav/.htpasswd
