# Copier en .env (gitignored) et renseigner les vraies valeurs.

# Mot de passe de l'interface d'admin Pi-hole.
PIHOLE_WEBPASSWORD=

# IP fixe (bail statique Freebox) du serveur, pour lier l'interface web
# au LAN uniquement plutôt qu'à toutes les interfaces.
PIHOLE_SERVER_IP=

# Résolveurs DNS en amont, séparés par ";" — résolveur de la box en premier
# pour garder la résolution des noms locaux, puis un secours public.
# Exemple : 192.168.1.254;9.9.9.9
PIHOLE_DNS_UPSTREAMS=
