# home-assistant/env.example
# Copier en .env (chmod 600, jamais versionné) et renseigner la vraie valeur.
#   cp env.example .env && chmod 600 .env && nano .env

# Adresse IPv4 du serveur sur le réseau local : liaison du port MQTT (1883).
# Valeur ci-dessous : adresse de documentation, à remplacer.
HOST_BIND_IP=192.0.2.10
