[Unit]
Description=Écoute réelle de la radio témoin de youtube-gateway et envoi du résultat à Uptime Kuma
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=rookain
# Une écoute réelle dure quelques secondes (extraction, ffmpeg) : marge large.
TimeoutStartSec=60
ExecStart=/bin/bash /opt/kiwinet-services/youtube-gateway/monitoring/uptime-kuma-push.sh flux
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes